+void llm_graph_input_of_ids::set_input(const llama_ubatch * ubatch) {
+    GGML_UNUSED(ubatch);
+    GGML_ASSERT(of_ids);
+
+    GGML_ASSERT(ggml_backend_buffer_is_host(of_ids->buffer));
+
+    GGML_ASSERT(cparams.output_filter != nullptr);
+    GGML_ASSERT((int32_t) cparams.output_filter->size() == n_ids);
+
+    // host buffer: plain copy from the context-owned filter list
+    memcpy(of_ids->data, cparams.output_filter->data(), n_ids * sizeof(int32_t));
+}
+
+bool llm_graph_input_of_ids::can_reuse(const llm_graph_params & params) {
+    GGML_UNUSED(params);
+    // contents are refilled by set_input on every decode, so reuse is safe
+    // as long as the tensor size (filter length) is unchanged
+    return cparams.n_output_filter == n_ids;
+}
