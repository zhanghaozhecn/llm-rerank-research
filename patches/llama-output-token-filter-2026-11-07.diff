+
+    auto inp = std::make_unique<llm_graph_input_of_ids>(cparams, cparams.n_output_filter);
+
+    auto & cur = inp->of_ids;
+
+    cur = ggml_new_tensor_1d(ctx0, GGML_TYPE_I32, cparams.n_output_filter);
